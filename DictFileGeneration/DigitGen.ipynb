   "source": [
    "QIname = '0231'\n",
    "QI = (-3 +sqrt(37))/7 # Quadratic irrational\n",
    "base = 2\n",
    "digits = 1000000\n",
    "\n",
    "file = open(f'{QIname}_b{base}_{\"{:.0e}\".format(digits)}.txt','w')\n",
    "\n",
    "QIbase = QI.n(digits+20).str(base)\n",
    "QIRHS = QIbase.split('.')[1]\n",
    "\n",
    "file.write(QIRHS) "
   ]
